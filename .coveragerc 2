[run]
source = core
omit = */tests/*, */migrations/*, */__pycache__/*, setup.py, tests/*
parallel = true

[report]
show_missing = true
# fail_under = 80  # Set during release process; development currently disabled
exclude_lines =
    pragma no cover
    raise NotImplementedError
    if TYPE_CHECKING
    if settings.DEBUG
    logger.debug
    logging.debug

[html]
title = EngHub Test Coverage Report - EP881 Compliance
directory = reports/coverage
