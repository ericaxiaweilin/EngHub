# ============================================================
# Docker 构建上下文忽略清单（构建上下文 = EngHub 根目录）
# 目的：减小上下文体积、避免把密钥/依赖/产物打进镜像
# 注意：前端源码 frontend/ 必须保留（多阶段构建需要），仅排除其 node_modules 与 dist
# ============================================================

# 版本控制
.git
.gitignore
.github

# Python 虚拟环境与缓存
.venv
.venv_stable
venv
**/__pycache__
**/*.pyc
.pytest_cache

# 环境变量/密钥（绝不进镜像）
.env
.env.*
*.env.*

# 前端依赖与构建产物（前端在镜像内多阶段重新构建）
**/node_modules
frontend/dist

# 日志与打包产物
logs
*.log
*.tar.gz

# 文档（不参与运行）
docs
